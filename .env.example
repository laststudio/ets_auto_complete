# Optional homework interface endpoint for the local mock server.
API_BASE_URL=http://127.0.0.1:8765
LOCAL_API_PID=local-demo
LOCAL_API_SECRET=local-demo
API_SYSTEM=4
API_VERSION=3
API_CLIENT_VERSION=5.4.5

# Real ETS platform configuration (used by ets-login/ets-list/ets-do).
# The signature secret key is built in (matching the official client), so the
# following values match the official client defaults and usually need no change.
ETS_API_URL=https://api.ets100.com
ETS_PID=grlx
ETS_SN=t
ETS_SYSTEM=4
ETS_VERSION=3
ETS_CLIENT_VERSION=5.4.5
# Only needed if the platform rotates its signature key:
# ETS_SECRET_KEY=555ffbe95ccf4e9535a110170b445ab8
# Optional fallback account used for auto re-login when a token expires.
ETS_PHONE=
ETS_PASS=
# Optional persistent device code; a stable one is generated and saved on first login.
ETS_DEVICE_CODE=
ETS_TIMEOUT=30
ETS_DISABLE_SSL_VERIFY=1

# Optional iFlytek ISE credentials.
ISE_APP_ID=
ISE_API_KEY=
ISE_API_SECRET=
ISE_WS_URL=wss://ise-api-dz-ets.xf-yun.com/v2/open-ise

# Optional HTTP(S) proxy. Example: http://127.0.0.1:18080
HTTPS_PROXY=

# Optional voice-cloning provider. No URL or key is built into the source.
CLONE_TTS_URL=
CLONE_TTS_RESULTS_URL=
CLONE_TTS_API_KEY=

# Optional generic HTTP TTS. style=openai or gradium.
HTTP_TTS_URL=
HTTP_TTS_API_KEY=
HTTP_TTS_STYLE=openai
HTTP_TTS_RESULTS_URL=
HTTP_TTS_MODEL=kokoro
HTTP_TTS_VOICE=af_bella
HTTP_TTS_SPEED=1.0
